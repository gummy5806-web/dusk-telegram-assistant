<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.dusk.triage</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-c</string>
        <string>cd "~/Documents/obsidian/my dusk" &amp;&amp; /bin/bash bot/triage_now.sh &gt;&gt; /tmp/dusk-triage.log 2&gt;&amp;1</string>
    </array>
    <key>StartInterval</key>
    <integer>3600</integer>
    <key>RunAtLoad</key>
    <false/>
    <key>StandardOutPath</key>
    <string>/tmp/dusk-triage-out.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/dusk-triage-err.log</string>
</dict>
</plist>
