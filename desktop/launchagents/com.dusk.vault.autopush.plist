<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.dusk.vault.autopush</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>-c</string>
		<string>cd "~/Documents/obsidian/my dusk" &amp;&amp; /usr/bin/git pull --rebase --autostash -q &amp;&amp; /usr/bin/git add -A &amp;&amp; /usr/bin/git diff --cached --quiet || /usr/bin/git commit -m "auto: vault sync $(date +%Y-%m-%d_%H:%M)" &amp;&amp; /usr/bin/git push</string>
	</array>
	<key>RunAtLoad</key>
	<false/>
	<key>StandardErrorPath</key>
	<string>/tmp/dusk-push-error.log</string>
	<key>StandardOutPath</key>
	<string>/tmp/dusk-push.log</string>
	<key>StartInterval</key>
	<integer>300</integer>
</dict>
</plist>
