# Supply real values only in ignored .env / external secret storage.
VAULT_PATH=/absolute/path/to/dusk-vault
RESEARCH_BRAIN_PATH=/absolute/path/to/research-brain
TELEGRAM_BOT_TOKEN=
TELEGRAM_USER_ID=0
DUSK_TIMEZONE=Asia/Almaty
DUSK_RUNTIME_DB=/absolute/path/to/runtime.sqlite3
# Optional model-backed background processing
LLM_PROVIDER=vertex
LLM_MODEL=gemini-2.5-flash
VERTEX_PROJECT=
VERTEX_LOCATION=global
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/adc.json
LLM_BASE_URL=
LLM_API_KEY=
# Voice transport: bot has no Deepgram provider keys.
DEEPGRAM_PROXY_URL=http://127.0.0.1:8321/v1/listen
DEEPGRAM_PROXY_CLIENT_KEY=
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=multi
DEEPGRAM_TIMEOUT_SECONDS=60
# Mac panel has a separate vault-path variable.
DUSK_VAULT_PATH=/absolute/path/to/dusk-vault
